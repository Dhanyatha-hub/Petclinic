pipeline {
    agent any
    
    tools{
        jdk 'jdk-17'
        maven 'maven3'
    }
    stages {
        stage('Git checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/jaiswaladi246/Petclinic.git'
            }
        }
        stage('Compile') {
            steps {
                sh "mvn clean compile"
            }
        }
       stage('build') {
            steps {
                sh "mvn clean package -DskipTest=True"
            }
       }
      
    }
}
